{
  "manifest_version": 3,
  "name": "Social Media Bell",
  "version": "1.0.1",
  "description": "Tells you when you get new notifications on X, Reddit, Facebook, Instagram, LinkedIn, Threads, Bluesky and more, with desktop alerts and a toolbar count.",
  "homepage_url": "https://github.com/jonpikereally/SocialMediaBell",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Social Media Bell",
    "default_popup": "app/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "permissions": ["storage", "alarms", "notifications", "cookies", "scripting"],
  "host_permissions": [
    "https://x.com/*", "https://*.x.com/*",
    "https://reddit.com/*", "https://*.reddit.com/*",
    "https://facebook.com/*", "https://*.facebook.com/*",
    "https://instagram.com/*", "https://*.instagram.com/*",
    "https://linkedin.com/*", "https://*.linkedin.com/*",
    "https://threads.com/*", "https://*.threads.com/*",
    "https://threads.net/*", "https://*.threads.net/*",
    "https://bsky.app/*", "https://*.bsky.app/*"
  ],
  "optional_host_permissions": ["https://*/*"]
}
